# --- Facebook / Messenger ---
# A verify token YOU make up. Type any random string here AND in the
# Meta webhook setup screen — they just have to match.
VERIFY_TOKEN=change-me-to-any-random-string

# From Meta App dashboard -> Messenger -> Settings -> "Generate token"
PAGE_ACCESS_TOKEN=

# From Meta App dashboard -> Settings -> Basic -> "App Secret"
# Used to verify that incoming requests really come from Facebook.
APP_SECRET=

# --- OpenAI (optional — enables smart, multilingual replies) ---
# Get it at https://platform.openai.com/api-keys (a ChatGPT Plus subscription
# does NOT include API access — the API is billed separately, pay-as-you-go).
# Leave blank to use the free local brain instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Server ---
PORT=5000
