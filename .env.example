# --- Facebook / Messenger ---
# A verify token YOU make up. Type any random string here AND in the
# Meta webhook setup screen — they just have to match.
VERIFY_TOKEN=change-me-to-any-random-string

# From Meta App dashboard -> Messenger -> Settings -> "Generate token"
PAGE_ACCESS_TOKEN=

# From Meta App dashboard -> Settings -> Basic -> "App Secret"
# Used to verify that incoming requests really come from Facebook.
APP_SECRET=

# --- LLM brain (optional — enables smart, generative, multilingual replies) ---
# With a key set, the bot answers freely (even questions you never pre-wrote),
# grounded in your knowledge.json facts. Leave ALL blank to use the free local
# brain only. Provider is auto-picked: Gemini first, then OpenAI.

# Google Gemini — FREE tier, great Albanian + English. No card needed.
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# gemini-2.5-flash is a solid free default. Use gemini-flash-latest to always
# track the current flash model (auto-updates if one is retired).
GEMINI_MODEL=gemini-2.5-flash

# OpenAI — pay-as-you-go (a ChatGPT Plus subscription does NOT include API
# access — the API is billed separately). https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Force a brain: "auto" (default), "gemini", "openai", or "local".
LLM_PROVIDER=auto

# --- Persistence & team tools (optional) ---
# Where the SQLite DB lives (history, state, audit, leads). Default: ./cargoteer.db
DB_PATH=
# Protects /admin/* endpoints (leads, conversations, handoffs). Blank = disabled.
ADMIN_TOKEN=
# Slack/Discord-style incoming webhook; bot POSTs {"text":...} on handoff/leads.
ADMIN_WEBHOOK_URL=

# --- Server ---
PORT=5000
